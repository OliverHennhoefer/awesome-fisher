<section class="demo" aria-labelledby="randomization-demo-title">
  <div class="demo-header">
    <h3 id="randomization-demo-title">Randomize within blocks</h3>
    <span>Interactive demonstration</span>
  </div>
  <div class="demo-body">
    <p>Four treatments are assigned once within each row-shaped block. Blocking keeps a known gradient from being confused with treatment.</p>
    <div class="field-grid" id="field-grid" aria-live="polite" aria-label="Four blocks containing randomized treatments">
      {['A','B','C','D','B','D','A','C','C','A','D','B','D','C','B','A'].map((treatment) => <div class="field-plot">{treatment}</div>)}
    </div>
    <div class="field-controls">
      <button type="button" id="randomize-field">Randomize again</button>
      <span class="search-status">Each row still contains A, B, C, and D exactly once.</span>
    </div>
    <noscript><p class="search-status">The displayed assignment is one valid randomized layout. Enable JavaScript to draw new assignments.</p></noscript>
  </div>
</section>

<script>
  const grid = document.querySelector<HTMLElement>('#field-grid');
  const button = document.querySelector<HTMLButtonElement>('#randomize-field');
  const treatments = ['A', 'B', 'C', 'D'];

  function randomIndex(max: number) {
    const values = new Uint32Array(1);
    crypto.getRandomValues(values);
    return values[0] % max;
  }

  function shuffledTreatments() {
    const copy = [...treatments];
    for (let index = copy.length - 1; index > 0; index -= 1) {
      const swap = randomIndex(index + 1);
      [copy[index], copy[swap]] = [copy[swap], copy[index]];
    }
    return copy;
  }

  button?.addEventListener('click', () => {
    if (!grid) return;
    const assignment = Array.from({ length: 4 }, shuffledTreatments).flat();
    [...grid.children].forEach((plot, index) => { plot.textContent = assignment[index]; });
  });
</script>
