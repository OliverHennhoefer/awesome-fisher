<section class="demo" aria-labelledby="exact-demo-title">
  <div class="demo-header">
    <h3 id="exact-demo-title">Condition on the margins</h3>
    <span>Interactive demonstration</span>
  </div>
  <div class="demo-body" id="exact-test-demo">
    <p>Edit the four cells. The display recomputes the two-sided conditional p-value by summing tables no more probable than the observed table.</p>
    <div class="demo-grid">
      {[
        ['a', 'Treatment / outcome', 8],
        ['b', 'Treatment / no outcome', 2],
        ['c', 'Control / outcome', 1],
        ['d', 'Control / no outcome', 5],
      ].map(([name, label, value]) => (
        <div class="control">
          <label for={`cell-${String(name)}`}>{label}</label>
          <input id={`cell-${String(name)}`} name={String(name)} type="number" min="0" max="200" value={String(value)} inputmode="numeric" />
        </div>
      ))}
    </div>
    <div class="demo-output" aria-live="polite">
      <span class="meta">Two-sided p-value</span><br />
      <strong id="exact-result">0.0350</strong>
      <p class="search-status" id="exact-detail">Conditional on both row and column totals.</p>
      <div class="probability-bars" id="exact-bars" aria-label="Conditional probabilities of all possible tables"></div>
    </div>
    <noscript><p class="search-status">For the table [[8, 2], [1, 5]], the conventional two-sided p-value is about 0.035.</p></noscript>
  </div>
</section>

<script>
  import { fisherExactDistribution, fisherExactTwoSided, type ContingencyTable } from '@/lib/statistics';

  const root = document.querySelector<HTMLElement>('#exact-test-demo');
  const result = root?.querySelector<HTMLElement>('#exact-result');
  const detail = root?.querySelector<HTMLElement>('#exact-detail');
  const bars = root?.querySelector<HTMLElement>('#exact-bars');
  const inputs = root ? [...root.querySelectorAll<HTMLInputElement>('input[type="number"]')] : [];

  function update() {
    const table = inputs.map((input) => Number(input.value)) as ContingencyTable;
    try {
      const p = fisherExactTwoSided(table);
      const distribution = fisherExactDistribution(table);
      const maximum = Math.max(...distribution.map((item) => item.probability));
      if (result) result.textContent = p < 0.0001 ? '< 0.0001' : p.toFixed(4);
      if (detail) detail.textContent = `${distribution.length} possible tables share these margins.`;
      if (bars) {
        bars.replaceChildren(...distribution.map((item) => {
          const bar = document.createElement('span');
          bar.className = `probability-bar${item.a === table[0] ? ' observed' : ''}`;
          bar.style.height = `${Math.max(2, (item.probability / maximum) * 110)}px`;
          bar.title = `a = ${item.a}; probability ${item.probability.toFixed(4)}`;
          return bar;
        }));
      }
    } catch {
      if (result) result.textContent = '—';
      if (detail) detail.textContent = 'Enter four non-negative whole numbers.';
      bars?.replaceChildren();
    }
  }

  inputs.forEach((input) => input.addEventListener('input', update));
  update();
</script>
