---
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import 'katex/dist/katex.min.css';
import '@/styles/global.css';
import { site, withBase } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  pagefind?: boolean;
  robots?: string;
  article?: {
    modifiedAt: Date;
    sections: string[];
    keywords: string[];
    authors: string[];
    citations: string[];
  };
  breadcrumbs?: Array<{ name: string; path: string }>;
}

const {
  title,
  description = site.description,
  pagefind = false,
  robots = 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1',
  article,
  breadcrumbs = [],
} = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL(withBase('/'), Astro.site);
const path = Astro.url.pathname;
const websiteId = `${home.href}#website`;
const personId = `${home.href}#ronald-fisher`;
const webpageId = `${canonical.href}#webpage`;
const articleId = `${canonical.href}#article`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': personId,
    name: site.subject.name,
    alternateName: site.subject.alternateNames,
    birthDate: site.subject.birthDate,
    deathDate: site.subject.deathDate,
    sameAs: site.subject.sameAs,
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: home.href,
    name: site.title,
    description: site.description,
    inLanguage: site.language,
    about: { '@id': personId },
    license: site.contentLicense,
    isAccessibleForFree: true,
  },
  {
    '@type': 'WebPage',
    '@id': webpageId,
    url: canonical.href,
    name: pageTitle,
    description,
    inLanguage: site.language,
    isPartOf: { '@id': websiteId },
    about: { '@id': personId },
    ...(article ? { mainEntity: { '@id': articleId } } : {}),
  },
];

if (article) {
  graph.push({
    '@type': 'Article',
    '@id': articleId,
    url: canonical.href,
    mainEntityOfPage: { '@id': webpageId },
    headline: title,
    description,
    dateModified: article.modifiedAt.toISOString(),
    inLanguage: site.language,
    isAccessibleForFree: true,
    license: site.contentLicense,
    about: { '@id': personId },
    articleSection: article.sections,
    keywords: article.keywords,
    author: article.authors.map((name) => ({ '@type': 'Person', name })),
    citation: article.citations,
  });
}

if (breadcrumbs.length >= 2) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical.href}#breadcrumb`,
    itemListElement: breadcrumbs.map((breadcrumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: breadcrumb.name,
      item: new URL(withBase(breadcrumb.path), Astro.site).href,
    })),
  });
}

const structuredData = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f8f8f5" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="license" href={site.contentLicense} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {article && <meta property="article:modified_time" content={article.modifiedAt.toISOString()} />}
    {article?.sections.map((section) => <meta property="article:section" content={section} />)}
    {article?.keywords.map((keyword) => <meta property="article:tag" content={keyword} />)}
    <script type="application/ld+json" is:inline set:html={structuredData}></script>
    <title>{pageTitle}</title>
    {pagefind && <meta data-pagefind-meta="title" content={pageTitle} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-pagefind-ignore>
      <div class="header-inner">
        <a class="wordmark" href={withBase('/')} aria-label="The Fisher Index, home">
          The Fisher Index <span>/ R. A. Fisher</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href={withBase('/contributions/')} aria-current={path.includes('/contributions') ? 'page' : undefined}>Contributions</a>
          <a href={withBase('/timeline/')} aria-current={path.includes('/timeline') ? 'page' : undefined}>Timeline</a>
          <a href={withBase('/biography/')} aria-current={path.includes('/biography') ? 'page' : undefined}>Biography</a>
          <a href={withBase('/context/')} aria-current={path.includes('/context') ? 'page' : undefined}>Context</a>
        </nav>
      </div>
    </header>
    <main id="main" data-pagefind-body={pagefind || undefined}>
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="footer-inner">
        <p><strong>The Fisher Index</strong><br />An evolving, critical guide to a consequential scientific legacy.</p>
        <div class="footer-links">
          <a href={withBase('/life/')}>Life and work</a>
          <a href={withBase('/timeline/')}>Timeline</a>
          <a href={withBase('/biography/')}>Biography</a>
          <a href={withBase('/editorial-policy/')}>Editorial policy</a>
          <a href={withBase('/sources/')}>Sources</a>
          <a href={withBase('/contribute/')}>Contribute</a>
        </div>
        <div class="footer-links">
          <a href={site.repository}>GitHub repository</a>
          <span>Code: MIT</span>
          <span>Content: CC BY 4.0</span>
        </div>
      </div>
    </footer>
  </body>
</html>
