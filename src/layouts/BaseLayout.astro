---
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import 'katex/dist/katex.min.css';
import '@/styles/global.css';
import { site, withBase } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  pagefind?: boolean;
}

const {
  title,
  description = site.description,
  pagefind = false,
} = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f8f5" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
    {pagefind && <meta data-pagefind-meta="title" content={pageTitle} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-pagefind-ignore>
      <div class="header-inner">
        <a class="wordmark" href={withBase('/')} aria-label="The Fisher Index, home">
          The Fisher Index <span>/ R. A. Fisher</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href={withBase('/contributions/')} aria-current={path.includes('/contributions') ? 'page' : undefined}>Contributions</a>
          <a href={withBase('/timeline/')} aria-current={path.includes('/timeline') ? 'page' : undefined}>Timeline</a>
          <a href={withBase('/biography/')} aria-current={path.includes('/biography') ? 'page' : undefined}>Biography</a>
          <a href={withBase('/context/')} aria-current={path.includes('/context') ? 'page' : undefined}>Context</a>
          <a href={withBase('/search/')} aria-current={path.includes('/search') ? 'page' : undefined}>Search</a>
        </nav>
      </div>
    </header>
    <main id="main" data-pagefind-body={pagefind || undefined}>
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="footer-inner">
        <p><strong>The Fisher Index</strong><br />An evolving, critical guide to a consequential scientific legacy.</p>
        <div class="footer-links">
          <a href={withBase('/life/')}>Life and work</a>
          <a href={withBase('/timeline/')}>Timeline</a>
          <a href={withBase('/biography/')}>Biography</a>
          <a href={withBase('/editorial-policy/')}>Editorial policy</a>
          <a href={withBase('/sources/')}>Sources</a>
          <a href={withBase('/contribute/')}>Contribute</a>
        </div>
        <div class="footer-links">
          <a href={site.repository}>GitHub repository</a>
          <span>Code: MIT</span>
          <span>Content: CC BY 4.0</span>
        </div>
      </div>
    </footer>
  </body>
</html>
