---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorksTimeline from '@/components/WorksTimeline.astro';
import { getPublishedContributions } from '@/lib/content';

const contributions = await getPublishedContributions();
---

<BaseLayout title="Timeline" description="A chronological Gantt-style view of the documented periods behind contributions associated with Ronald A. Fisher." pagefind>
  <div class="page-shell works-timeline-page">
    <div class="narrow works-timeline-intro">
      <p class="eyebrow">The work / in time</p>
      <h1 data-pagefind-meta="title">The work in time.</h1>
      <p class="lede">The index arranged by when each contribution emerged, developed, or acquired the form documented in its article.</p>
      <p class="callout context-callout"><strong>How to read the bars.</strong> Each span reproduces the reviewed period recorded on its contribution page. “And later” developments remain named in the article but do not receive an invented end date here.</p>
    </div>

    <WorksTimeline entries={contributions} />
  </div>
</BaseLayout>
