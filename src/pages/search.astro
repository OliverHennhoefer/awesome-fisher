---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchPanel from '@/components/SearchPanel.astro';
---

<BaseLayout title="Search" description="Search The Fisher Index by title, alias, definition, field, or full article text.">
  <div class="page-shell narrow">
    <p class="eyebrow">Static full-text index</p>
    <h1>Search</h1>
    <p class="lede">Search mathematical names, plain-language descriptions, collaborators, aliases, and article text. The index stays entirely in your browser.</p>
    <SearchPanel autofocus />
  </div>
</BaseLayout>
