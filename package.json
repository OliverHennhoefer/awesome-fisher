{
  "name": "the-fisher-index",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build:site": "astro build",
    "index": "pagefind --site dist",
    "build": "npm run validate && npm run build:site && npm run index && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "node scripts/validate-content.mjs && node scripts/validate-ideas.mjs",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "@fontsource/source-serif-4": "^5.0.0",
    "astro": "^7.1.6",
    "katex": "^0.16.0",
    "rehype-katex": "^7.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@astrojs/check": "^0.9.0",
    "@playwright/test": "^1.58.0",
    "gray-matter": "^4.0.0",
    "pagefind": "^1.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
